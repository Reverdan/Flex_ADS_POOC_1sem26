// Passo 2 & 3: Criar a classe e a propriedade 
public class ContaBancaria 
{ 
    // Passo 2: Campo privado (Backing Field) 
    // Relatório: Privado para impedir que códigos externos alterem o valor  
    // sem passar pelas regras de validação (saque/depósito). 
    private decimal _saldo; 
 

// Passo 3: Propriedade Saldo 
    // Relatório: O 'private set' garante que o saldo só mude via métodos internos. 
    public decimal Saldo  
    {  
        get => _saldo;  
        private set => _saldo = value;  
    } 
 

// Extensão: Histórico de operações 
    private List<string> _historico = new List<string>(); 
 

// Passo 4: Construtor com parâmetro opcional 
    // Relatório: Parâmetro opcional permite criar conta com 0 sem passar valor. 
    // O sufixo 'm' indica que o número é um literal do tipo decimal (precisão financeira). 
    public ContaBancaria(decimal saldoInicial = 0m) 
    { 
        // Extensão: Validação de saldo inicial 
        Saldo = saldoInicial < 0 ? 0m : saldoInicial; 
        RegistrarAcao($"Abertura de conta com {Saldo:C2}"); 
    } 
 

// Passo 5: Implementar Depositar 
    // Relatório: A regra 'quantia > 0' evita depósitos nulos ou negativos que quebrariam a lógica. 
    public bool Depositar(decimal quantia) 
    { 
        if (quantia <= 0)  
        { 
            RegistrarAcao($"Tentativa de depósito inválida: {quantia:C2}"); 
            return false; 
        } 
 

Saldo += quantia; 
        RegistrarAcao($"Depósito realizado: {quantia:C2}"); 
        return true; 
    } 
 

// Passo 6: Implementar Sacar 
    // Relatório: Evita saldo negativo e garante que a quantia seja válida. 
    public bool Sacar(decimal quantia) 
    { 
        if (quantia <= 0 || quantia > Saldo) 
        { 
            RegistrarAcao($"Tentativa de saque negada: {quantia:C2}"); 
            return false; 
        } 
 

Saldo -= quantia; 
        RegistrarAcao($"Saque realizado: {quantia:C2}"); 
        return true; 
    } 
 

private void RegistrarAcao(string mensagem) 
    { 
        _historico.Add($"{DateTime.Now:HH:mm:ss} - {mensagem} | Saldo Atual: {Saldo:C2}"); 
    } 
 

public void ExibirHistorico() 
    { 
        Console.WriteLine("\n--- HISTÓRICO DA CONTA ---"); 
        _historico.ForEach(Console.WriteLine); 
    } 
} 
 

// Extensão: Menu no Console 
public class MenuConta 
{ 
    private ContaBancaria _conta; 
 

public MenuConta(ContaBancaria conta) => _conta = conta; 
 

public void Exibir() 
    { 
        string opcao = ""; 
        while (opcao != "0") 
        { 
            Console.WriteLine($"\nSaldo Atual: {_conta.Saldo:C2}"); 
            Console.WriteLine("1. Depositar | 2. Sacar | 3. Ver Histórico | 0. Sair"); 
            Console.Write("Escolha: "); 
            opcao = Console.ReadLine(); 
 

switch (opcao) 
            { 
                case "1": 
                    ProcessarOperacao("depósito", _conta.Depositar); 
                    break; 
                case "2": 
                    ProcessarOperacao("saque", _conta.Sacar); 
                    break; 
                case "3": 
                    _conta.ExibirHistorico(); 
                    break; 
            } 
        } 
    } 
 

private void ProcessarOperacao(string tipo, Func<decimal, bool> operacao) 
    { 
        Console.Write($"Valor para {tipo}: "); 
        if (decimal.TryParse(Console.ReadLine(), out decimal valor)) 
        { 
            bool sucesso = operacao(valor); 
            Console.WriteLine(sucesso ? "Operação realizada!" : "Operação recusada (valor inválido ou insuficiente)."); 
        } 
    } 
} 
 


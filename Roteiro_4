Com certeza! Vamos implementar a Transferência Bancária, que é um dos melhores exemplos de como reutilizar métodos existentes (Sacar e Depositar) para criar uma lógica mais complexa com segurança. 

Para garantir que o dinheiro não "desapareça" no meio do caminho, a regra é: o saque na conta de origem só deve ser confirmado se o depósito na conta de destino for possível. 

Aqui está o código atualizado com o método Transferir e um pequeno teste no Main: 

C# 

 

public class ContaBancaria 
{ 
    private decimal _saldo; 
    public decimal Saldo { get; private set; } 
    private List<string> _historico = new List<string>(); 
 

public ContaBancaria(decimal saldoInicial = 0m) 
    { 
        Saldo = saldoInicial < 0 ? 0m : saldoInicial; 
        RegistrarAcao("Abertura de conta."); 
    } 
 

public bool Depositar(decimal quantia) 
    { 
        if (quantia <= 0) return false; 
        Saldo += quantia; 
        RegistrarAcao($"Depósito: {quantia:C2}"); 
        return true; 
    } 
 

public bool Sacar(decimal quantia) 
    { 
        if (quantia <= 0 || quantia > Saldo) return false; 
        Saldo -= quantia; 
        RegistrarAcao($"Saque: {quantia:C2}"); 
        return true; 
    } 
 

// --- Extensão: Transferência entre Contas --- 
    public bool Transferir(ContaBancaria destino, decimal quantia) 
    { 
        // 1. Validação básica: destino não pode ser nulo e quantia deve ser positiva 
        if (destino == null || quantia <= 0) return false; 
 

// 2. Tenta sacar da conta atual (origem) 
        if (this.Sacar(quantia)) 
        { 
            // 3. Se o saque funcionou, deposita no destino 
            if (destino.Depositar(quantia)) 
            { 
                RegistrarAcao($"Transferência enviada: {quantia:C2} para conta destino."); 
                destino.RegistrarAcao($"Transferência recebida: {quantia:C2} de conta origem."); 
                return true; 
            } 
            else 
            { 
                // 4. Caso o depósito falhe por algum motivo raro, devolve o dinheiro (Rollback) 
                this.Depositar(quantia); 
                return false; 
            } 
        } 
 

return false; 
    } 
 

private void RegistrarAcao(string msg) => _historico.Add($"{DateTime.Now:HH:mm} - {msg}"); 
} 
 

// --- Exemplo de Teste de Transferência --- 
var contaA = new ContaBancaria(500m); 
var contaB = new ContaBancaria(100m); 
 

Console.WriteLine($"Saldo A: {contaA.Saldo:C2} | Saldo B: {contaB.Saldo:C2}"); 
 

if (contaA.Transferir(contaB, 200m)) 
{ 
    Console.WriteLine("Transferência de R$ 200,00 realizada com sucesso!"); 
} 
 

Console.WriteLine($"Novo Saldo A: {contaA.Saldo:C2} | Novo Saldo B: {contaB.Saldo:C2}"); 
 

Por que essa lógica é segura? 

Encapsulamento: Usamos os métodos Sacar e Depositar que já possuem as travas de segurança (não deixar saldo negativo, não aceitar valores nulos). 

Atomicidade Simples: O código verifica se o saque foi possível antes de tentar o depósito. Se o saldo de A for insuficiente, o método retorna false imediatamente e nada acontece com a conta B. 
